{
  "name": "@fricken/cli",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briannadoubt/Frick.git",
    "directory": "apps/cli"
  },
  "bin": {
