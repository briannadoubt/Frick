{
  "name": "@fricken/server",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briannadoubt/Frick.git",
    "directory": "apps/server"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./push/apns-adapter": {
      "types": "./dist/push/apns-adapter.d.ts",
      "import": "./dist/push/apns-adapter.js",
      "default": "./dist/push/apns-adapter.js"
    },
    "./push/fcm-adapter": {
      "types": "./dist/push/fcm-adapter.d.ts",
      "import": "./dist/push/fcm-adapter.js",
      "default": "./dist/push/fcm-adapter.js"
    },
    "./email/resend-adapter": {
      "types": "./dist/email/resend-adapter.d.ts",
      "import": "./dist/email/resend-adapter.js",
      "default": "./dist/email/resend-adapter.js"
    },
    "./push/web-push-adapter": {
      "types": "./dist/push/web-push-adapter.d.ts",
      "import": "./dist/push/web-push-adapter.js",
      "default": "./dist/push/web-push-adapter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@fricken/protocol": "workspace:*",
    "@msgpack/msgpack": "^3.1.2",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@types/pg": "^8.20.0",
    "@xmldom/xmldom": "^0.9.10",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.21.0",
    "ws": "^8.18.3",
    "xml-crypto": "^6.1.2"
  },
  "optionalDependencies": {
    "mediasoup": "^3.14.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
