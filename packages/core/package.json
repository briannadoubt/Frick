{
  "name": "@fricken/core",
  "version": "0.4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briannadoubt/Frick.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js",
      "default": "./dist/analytics.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js",
      "default": "./dist/telemetry.js"
    },
    "./errors": {
      "types": "./dist/generated/errors.d.ts",
      "import": "./dist/generated/errors.js",
      "default": "./dist/generated/errors.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fricken/protocol": "workspace:*",
    "@opentelemetry/api": "^1.9.1"
  },
  "optionalDependencies": {
    "mediasoup-client": "^3.7.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3"
  }
}
